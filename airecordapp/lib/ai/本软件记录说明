1.android 构建APK时出错：算法HmacPBESHA256不可用
可手动生成
keytool -genkey -v -keystore debug.keystore -alias androiddebugkey -keyalg RSA -keysize 2048 -validity 10000 -storetype JKS
2.打包操作
配置打包参数android/app/build.gradle
    signingConfigs {
        release {
            storeFile file('../debug.keystore')
            storePassword = 'YOUR_KEYSTORE_PASSWORD' // 对应生成keystore输入的密码
            keyAlias = 'your_alias' // 对应生成key别名文件
            keyPassword = 'YOUR_KEY_PASSWORD' // 生成文件时候对应输入的密码
        }
    }
    buildTypes {
        release {
            // TODO: Add your own signing config for the release build.
            // Signing with the debug keys for now, so `flutter run --release` works.
            signingConfig = signingConfigs.release
        }
    }
